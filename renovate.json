{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
      "config:recommended",
      "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex"
  ],
  "minimumReleaseAge": "10 days",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.*config\\/smoke-test\\/smoke_test_cronjob\\.yaml/"
      ],
      "matchStrings": [
        "ghcr.io/alphagov/govuk/govuk-toolbox-image:(?<currentValue>v[0-9.]+)"
      ],
      "packageNameTemplate": "alphagov/govuk-toolbox-image",
      "depNameTemplate": "Toolbox image",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["alphagov/govuk-infrastructure"],
      "matchDepTypes": ["action"],
      "enabled": false
    }
  ]
}