{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex"
  ],
  "minimumReleaseAge": "10 days",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.*config\\/smoke-test\\/smoke_test_cronjob\\.yaml/"
      ],
      "matchStrings": [
        "ghcr.io/alphagov/govuk/govuk-toolbox-image:(?<currentValue>v[0-9.]+)"
      ],
      "packageNameTemplate": "alphagov/govuk-toolbox-image",
      "depNameTemplate": "Toolbox image",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.custom-gcl\\.yml/"
      ],
      "matchStrings": [
        "version:\\s*(?<currentValue>v[0-9.]+)"
      ],
      "packageNameTemplate": "golangci/golangci-lint",
      "depNameTemplate": "golangci-lint",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "GOLANGCI_LINT_VERSION\\s*\\?=\\s*(?<currentValue>v[0-9.]+)"
      ],
      "packageNameTemplate": "golangci/golangci-lint",
      "depNameTemplate": "golangci-lint",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "alphagov/govuk-infrastructure"
      ],
      "matchDepTypes": [
        "action"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "golangci/golangci-lint"
      ],
      "groupName": "golangci-lint"
    }
  ]
}